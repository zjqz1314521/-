#include <stdio.h>

//aim ;bubble sort
int data[5];
int i;
int j;
int temp;

int main(){
	printf("请输入数据：\n");
	for(i =0 ; i <5 ; i++){
		scanf("%d" ,&data[i]);
	}
	for(i =0 ; i <5 ; i++){
		for(j = 0;j < 5-1-i ;j++){
			if(data[j]>data[j+1]){
				temp = data[j];  //
				data[j] = data[j+1];
				data[j+1] =temp;
			}
		}
	}
	for(i =0;i<5;i++){
		printf("%d " ,data[i]);
	}
	printf("\n");
	return 0;
}
